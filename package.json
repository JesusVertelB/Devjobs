{
  "name": "devjobs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:css": "tailwindcss -i ./frontend/tailwind.input.css -o ./frontend/tailwind.css --config ./frontend/tailwind.config.js --minify",
    "watch:css": "tailwindcss -i ./frontend/tailwind.input.css -o ./frontend/tailwind.css --config ./frontend/tailwind.config.js --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.13"
  }
}
